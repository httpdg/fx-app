# Токен бота из BotFather
BOT_TOKEN=

# Любая длинная случайная строка — секрет для подписи сессионной куки.
# Сгенерировать можно так: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Строка подключения к Postgres от Railway (супер-юзер) — нужна ТОЛЬКО
# чтобы прогнать миграцию и тестовый скрипт. Сервер под ней НЕ работает.
DATABASE_URL=

# Строка подключения ограниченной роли app_user (см. sql/001_init.sql).
# Именно её сервер использует для всех запросов.
APP_DATABASE_URL=

PORT=3000
